<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
	<sitecore>
		<services>
			<graphql>
				<complexityConfiguration>
					<maxDepth patch:instead="*">19</maxDepth>
					<!-- Increase maxDepth only -->
				</complexityConfiguration>
			</graphql>
		</services>
	</sitecore>
</configuration>