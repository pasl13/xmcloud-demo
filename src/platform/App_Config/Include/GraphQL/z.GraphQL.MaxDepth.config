<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
	<sitecore>
		<api>
			<GraphQL>
				<defaults>
					<security>
						<publicService>
							<complexityConfiguration>
								<maxDepth patch:instead="*">19</maxDepth>
								<!-- Increase only maxDepth -->
							</complexityConfiguration>
						</publicService>
					</security>
				</defaults>
			</GraphQL>
		</api>
	</sitecore>
</configuration>